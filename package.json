{
  "name": "@specsrelay/dsh-deepseek",
  "version": "0.10.0",
  "description": "Native DeepSeek conversation capture, requirement analysis, and DSH Desktop handoff.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "specsrelay-dsh": "./bin/specsrelay-dsh.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyPandaGame/SpecsRelay-DSH.git"
  },
  "homepage": "https://github.com/TinyPandaGame/SpecsRelay-DSH#readme",
  "bugs": {
    "url": "https://github.com/TinyPandaGame/SpecsRelay-DSH/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client-native.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client-native.js",
    "lib",
    "bin",
    "installer",
    "docs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "specsrelay"
  ],
  "license": "MIT"
}
