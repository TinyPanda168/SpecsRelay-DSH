@@ -0,0 +1,128 @@
+/** Generation-scoped native WebContentsView panels for Desktop Host plugins. */
+
+import { type Context, Service } from '@deepseek-ai/cordis'
+import type { DesktopRuntime } from './runtime.ts'
+
+/** Rectangle in the DSH renderer's CSS viewport coordinates. */
+export interface DesktopWebPanelBounds {
+  /** Left offset in CSS pixels. */
+  x: number
+  /** Top offset in CSS pixels. */
+  y: number
+  /** Visible width in CSS pixels. */
+  width: number
+  /** Visible height in CSS pixels. */
+  height: number
+}
+
+/** One remote page owned by a Desktop Host plugin. */
+export interface DesktopWebPanelSpec {
+  /** Stable profile-local identity used for the persistent session partition. */
+  id: string
+  /** Initial HTTPS page. */
+  url: string
+  /** HTTPS origins allowed for main-frame navigation. */
+  allowedOrigins: readonly string[]
+}
+
+/** Observable state for one native Web panel. */
+export interface DesktopWebPanelStatus {
+  /** Current native lifecycle state. */
+  state: 'idle' | 'loading' | 'ready' | 'failed'
+  /** Last committed main-frame URL. */
+  url: string
+  /** Last load failure, when present. */
+  error?: string
+}
+
+/** Effect-scoped control surface returned to one Host plugin. */
+export interface DesktopWebPanelRegistration {
+  /** Stable caller-provided identity. */
+  readonly id: string
+  /** Read current lifecycle state without loading the page. */
+  status(): DesktopWebPanelStatus
+  /** Create and load the native page without making it visible. */
+  ready(): Promise<DesktopWebPanelStatus>
+  /** Place the native page above renderer CSS bounds, accounting for native chrome and zoom. */
+  show(bounds: DesktopWebPanelBounds): Promise<DesktopWebPanelStatus>
+  /** Hide the native page while retaining its login session and page state. */
+  hide(): void
+  /** Reload the current page and wait for navigation to settle. */
+  reload(): Promise<DesktopWebPanelStatus>
+  /**
+   * Evaluate a bundled capture expression inside the remote page.
+   * @param expression - fixed plugin-owned JavaScript, never request input.
+   * @returns the expression result copied across the Electron process boundary.
+   */
+  evaluate<T>(expression: string): Promise<T>
+  /** Remove the view and close its WebContents. Repeated disposal has no effect. */
+  dispose(): Promise<void>
+}
+
+/** Supported native-page capability available to Desktop Host plugins. */
+export interface DesktopWebPanels {
+  /**
+   * Register one HTTPS page for the current Cordis generation.
+   * @param spec - stable identity, initial page, and exact navigation origins.
+   * @returns an effect-scoped native panel registration.
+   */
+  register(spec: DesktopWebPanelSpec): DesktopWebPanelRegistration
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Native remote-page panels hosted above the sandboxed DSH Web renderer. */
+    desktopWebPanels: DesktopWebPanels
+  }
+}
+
+/** Cordis service that publishes the launcher-owned native panel adapter. */
+export class DesktopWebPanelService extends Service implements DesktopWebPanels {
+  private readonly registrations = new Set<DesktopWebPanelRegistration>()
+  private disposed = false
+
+  /**
+   * Register the public capability for one Desktop generation.
+   * @param ctx - Cordis context owning this exact service lifetime.
+   * @param runtime - launcher-private Electron adapter.
+   */
+  constructor(ctx: Context, private readonly runtime: DesktopRuntime) {
+    super(ctx, 'desktopWebPanels')
+    ctx.effect(
+      () => async () => {
+        this.disposed = true
+        const registrations = [...this.registrations]
+        this.registrations.clear()
+        await Promise.all(registrations.map(registration => registration.dispose()))
+      },
+      'dsh-plugin-desktop: native Web panel service lifetime',
+    )
+  }
+
+  /** @inheritdoc */
+  register(spec: DesktopWebPanelSpec): DesktopWebPanelRegistration {
+    if (this.disposed) {
+      throw new Error('dsh-plugin-desktop: desktopWebPanels service disposed')
+    }
+    const registration = this.runtime.registerWebPanel(spec)
+    this.registrations.add(registration)
+    let active = true
+    return {
+      id: registration.id,
+      status: () => registration.status(),
+      ready: () => registration.ready(),
+      show: bounds => registration.show(bounds),
+      hide: () => { registration.hide() },
+      reload: () => registration.reload(),
+      evaluate: expression => registration.evaluate(expression),
+      dispose: async () => {
+        if (!active) return
+        active = false
+        this.registrations.delete(registration)
+        await registration.dispose()
+      },
+    }
+  }
+}
+
+export default DesktopWebPanelService
