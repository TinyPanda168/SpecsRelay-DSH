+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import type { DesktopRuntime } from '../src/runtime.ts'
+import DesktopWebPanelService, {
+  type DesktopWebPanelRegistration,
+} from '../src/web-panels.ts'
+
+function createRegistration(): DesktopWebPanelRegistration {
+  return {
+    id: 'specsrelay-deepseek',
+    status: () => ({ state: 'idle', url: 'https://chat.deepseek.com/' }),
+    ready: async () => ({ state: 'ready', url: 'https://chat.deepseek.com/' }),
+    show: async () => ({ state: 'ready', url: 'https://chat.deepseek.com/' }),
+    hide: vi.fn(),
+    reload: async () => ({ state: 'ready', url: 'https://chat.deepseek.com/' }),
+    evaluate: async <T>() => ({ captured: true }) as T,
+    dispose: vi.fn(async () => {}),
+  }
+}
+
+describe('desktop Web panel service', () => {
+  it('publishes the native adapter and closes registrations with its generation', async () => {
+    const native = createRegistration()
+    const registerWebPanel = vi.fn(() => native)
+    const runtime = { registerWebPanel } as unknown as DesktopRuntime
+    const ctx = new Context()
+    const fiber = ctx.plugin(DesktopWebPanelService, runtime)
+    await fiber
+
+    const service = ctx.desktopWebPanels
+    const registration = service.register({
+      id: 'specsrelay-deepseek',
+      url: 'https://chat.deepseek.com/',
+      allowedOrigins: ['https://chat.deepseek.com'],
+    })
+    expect(registerWebPanel).toHaveBeenCalledOnce()
+    await expect(registration.evaluate<{ captured: boolean }>('capture()'))
+      .resolves.toEqual({ captured: true })
+
+    await fiber.dispose()
+    expect(native.dispose).toHaveBeenCalledOnce()
+    expect(ctx.get('desktopWebPanels')).toBeUndefined()
+    expect(() => service.register({
+      id: 'other',
+      url: 'https://example.com/',
+      allowedOrigins: ['https://example.com'],
+    })).toThrow('service disposed')
+  })
+
+  it('makes consumer disposal idempotent', async () => {
+    const native = createRegistration()
+    const ctx = new Context()
+    const fiber = ctx.plugin(
+      DesktopWebPanelService,
+      { registerWebPanel: () => native } as unknown as DesktopRuntime,
+    )
+    await fiber
+    const registration = ctx.desktopWebPanels.register({
+      id: 'specsrelay-deepseek',
+      url: 'https://chat.deepseek.com/',
+      allowedOrigins: ['https://chat.deepseek.com'],
+    })
+
+    await registration.dispose()
+    await registration.dispose()
+    await fiber.dispose()
+    expect(native.dispose).toHaveBeenCalledOnce()
+  })
+})
